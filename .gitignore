# Memory Bank (local session files, not versioned)
memory_bank/

# Cursor rules: only SATurday-specific rules are tracked
.cursor/rules/*
!.cursor/rules/lean4-development.mdc
!.cursor/rules/no-emojis.mdc
!.cursor/rules/programming-principles.mdc
!.cursor/rules/python-development.mdc
!.cursor/rules/saturday-loop-autonomy.mdc

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
**/build/
!infra/build/*.sh

# Lean 4
theory/build/
theory/.lake/
theory/lake-packages/
theory/.cache/
*.olean

# SAT Solvers and proof checkers (built locally by infra/build scripts)
infra/build/kissat
infra/build/kissat-src/
infra/build/cadical
infra/build/drat-trim
infra/build/drat-trim.c
*.o
*.a

# Proof Artifacts (generated by solver runs)
proofs/
!proofs/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Logs
*.log
search/logs/
search/logs/*.jsonl
!search/logs/falsifier_runs.jsonl
!search/logs/saturday_sessions.jsonl

# Generated Artifacts (test/execution outputs)
docs/reports/
search/plans/generated/
search/specs/

# Archived dead program (kept on disk, bulk not versioned; see docs/postmortems/)
archive/theory/Conjectures/BetA/
archive/theory/Conjectures/BetB/
archive/theory/Conjectures/BetC/
archive/theory/Conjectures/BetD/

