#!/usr/bin/env python3
"""
Real proof verification wrapper around drat-trim.

Replaces the former stub that only checked the proof file was non-empty. This
wrapper runs the drat-trim checker (built by infra/build/lrat_check_build.sh at
infra/build/drat-trim) against the original DIMACS CNF and the solver proof.

Facts this wrapper is honest about:
- kissat 3.1.1 emits BINARY DRAT proofs; the repo's .lrat file extension is
  historical. drat-trim auto-detects binary mode and checks DRAT directly.
- Verification passes only on an explicit "s VERIFIED" line from drat-trim.
- Gzip-compressed CNF or proof files are transparently decompressed to
  temporary files for checking and cleaned up afterward.

CLI (kept compatible with search/tools/artifact_store.py):
    verify_lrat --cnf <file[.gz]> --lrat <file[.gz]> [--timeout SECONDS]

Exit codes: 0 verified, 1 anything else (not verified, missing files, timeout,
checker missing). A JSON summary is printed to stdout; logs go to stderr.

LOG: real drat-trim proof verification wrapper
"""

import argparse
import gzip
import json
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Dict, Optional, Tuple

REPO_ROOT = Path(__file__).resolve().parent.parent.parent
DRAT_TRIM = REPO_ROOT / "infra" / "build" / "drat-trim"


def log(message: str) -> None:
    """Timestamped stderr logging."""
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[verify_lrat {timestamp}] {message}", file=sys.stderr)


def materialize(path: Path, tmpdir: Path, label: str) -> Optional[Path]:
    """
    Return a plain-file path for the input, decompressing .gz into tmpdir.
    Returns None if the file does not exist.
    """
    if not path.exists():
        log(f"ERROR: {label} file not found: {path}")
        return None
    if path.suffix != ".gz":
        log(f"{label}: {path} ({path.stat().st_size} bytes, uncompressed)")
        return path
    target = tmpdir / path.stem  # strip the .gz suffix
    log(f"{label}: decompressing {path} to {target}")
    with gzip.open(path, "rb") as f_in, open(target, "wb") as f_out:
        shutil.copyfileobj(f_in, f_out)
    log(f"{label}: decompressed size {target.stat().st_size} bytes")
    return target


def parse_stats(output: str) -> Dict[str, Optional[int]]:
    """
    Extract honest proof-size statistics from drat-trim output lines like:
      c 143 of 181 lemmas in core using 2085 resolution steps
    """
    stats: Dict[str, Optional[int]] = {
        "core_lemmas": None, "total_lemmas": None, "resolution_steps": None,
    }
    for line in output.splitlines():
        # Format: c 143 of 181 lemmas in core using 2085 resolution steps
        parts = line.split()
        if "lemmas in core using" in line and len(parts) >= 11:
            try:
                stats["core_lemmas"] = int(parts[1])
                stats["total_lemmas"] = int(parts[3])
                stats["resolution_steps"] = int(parts[8])
            except (ValueError, IndexError):
                log(f"WARNING: could not parse stats line: {line}")
    return stats


def verify(cnf_path: Path, proof_path: Path, timeout_s: int) -> Tuple[bool, Dict]:
    """Run drat-trim and decide strictly on the presence of 's VERIFIED'."""
    result: Dict = {
        "verified": False,
        "checker": "drat-trim",
        "cnf": str(cnf_path),
        "proof": str(proof_path),
        "timeout_s": timeout_s,
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
    }

    if not DRAT_TRIM.exists():
        log(f"ERROR: drat-trim binary missing at {DRAT_TRIM}")
        log("Run: bash infra/build/lrat_check_build.sh")
        result["message"] = "checker binary missing"
        return False, result

    with tempfile.TemporaryDirectory(prefix="verify_lrat_") as tmp:
        tmpdir = Path(tmp)
        cnf = materialize(cnf_path, tmpdir, "CNF")
        proof = materialize(proof_path, tmpdir, "proof")
        if cnf is None or proof is None:
            result["message"] = "input file missing"
            return False, result

        cmd = [str(DRAT_TRIM), str(cnf), str(proof)]
        log(f"running: {' '.join(cmd)} (timeout {timeout_s}s)")
        start = time.time()
        try:
            proc = subprocess.run(
                cmd, capture_output=True, text=True, timeout=timeout_s,
            )
        except subprocess.TimeoutExpired:
            elapsed = time.time() - start
            log(f"TIMEOUT after {elapsed:.1f}s")
            result["message"] = f"checker timeout after {timeout_s}s"
            result["elapsed_s"] = round(elapsed, 3)
            return False, result

        elapsed = time.time() - start
        for line in proc.stdout.splitlines():
            log(f"drat-trim: {line}")

        verified = any(
            line.strip() == "s VERIFIED" for line in proc.stdout.splitlines()
        )
        result.update(parse_stats(proc.stdout))
        result["verified"] = verified
        result["exit_code"] = proc.returncode
        result["elapsed_s"] = round(elapsed, 3)
        result["message"] = (
            "s VERIFIED" if verified
            else f"not verified (exit {proc.returncode})"
        )
        log(f"verdict: {result['message']} in {elapsed:.3f}s")
        return verified, result


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Verify a solver proof against its CNF with drat-trim"
    )
    parser.add_argument("--cnf", type=Path, required=True, help="DIMACS CNF file (.gz ok)")
    parser.add_argument("--lrat", type=Path, required=True,
                        help="proof file, binary or ASCII DRAT (.gz ok; historical flag name)")
    parser.add_argument("--timeout", type=int, default=300,
                        help="checker wall-clock cap in seconds (default 300)")
    args = parser.parse_args()

    log("=" * 60)
    log("drat-trim proof verification")
    log("=" * 60)

    verified, result = verify(args.cnf, args.lrat, args.timeout)
    print(json.dumps(result, indent=2))
    sys.exit(0 if verified else 1)


if __name__ == "__main__":
    main()
