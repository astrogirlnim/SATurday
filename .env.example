# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# OpenRouter model overrides for satday --remote
OPENROUTER_FORMALIZE_MODEL=
OPENROUTER_PROVE_MODEL=

# Local Ollama weight store (native Ollama env). Point at this volume when the
# internal disk is tight, then restart `ollama serve` with the same env.
# Example:
# OLLAMA_MODELS=/Volumes/SSK Drive/SATurday/models/ollama
OLLAMA_MODELS=

# Optional alias if you prefer not to set OLLAMA_MODELS in the shell that
# starts `ollama serve`. The loop exports OLLAMA_MODELS from this for child
# CLI calls; the daemon still needs a restart to pick it up.
SATURDAY_MODELS_DIR=

# Local role model name overrides (must already be pulled into the store)
SATURDAY_PROVE_MODEL=
SATURDAY_FORMALIZE_MODEL=
SATURDAY_AUDIT_MODEL=
