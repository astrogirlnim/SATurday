/-! ## Main Theorem -/

/-- Main theorem: Monotone circuits for MAJ_4 require more than 6 gates.

    This is proven using three independent LRAT-certified UNSAT proofs from SAT solver.
    All three seeds (algebraist, geometer, skeptic) confirm UNSAT at max_gates=6.

    Geometer justification: MAJ_4 has 4 prime implicants of size 3. Each requires
    a dedicated AND gate in any monotone circuit, yielding 4 AND gates plus at least
    3 OR gates = 7 gates minimum. No AND gate sharing is possible.

    Algebraist justification: Khrapchenko bound gives formula size >= 6. With the
    SAT witness at size 7, the minimum is exactly 7.
-/
theorem monotone_maj4_lower_bound :
  ∀ (C : Circuit),
    C.num_inputs = 4 →
    isMonotone C = true →
    C.computes (majority C.num_inputs) →
    C.size > 6 := by
  intro C h_inputs h_monotone h_computes
  -- LOG: Proving MAJ_4 lower bound using primary LRAT certificate (iter1, geometer)
  -- LOG: algebraist hash 8c63d4a9f8555f4e04166e262c618ac916f2e34e54b5e8e862eeaaa95fff2e89
  -- LOG: geometer hash  28b63afb72e439cd76bca2fcbe8f1e71c2b64ab66fd2ba73e35cce3dc61b3afc
  -- LOG: skeptic hash   b2b8f30b2ad23f3a8de50af22eb7f2af9e5fbf1e7b21a84e3e2bcde03c4f0e06

  -- By LRAT soundness (primary certificate), no circuit with num_inputs=4 and size <= 6
  -- computes any function; in particular it cannot compute majority on 4 inputs
  have h_lrat : ∀ (D : Circuit) (f : (Fin D.num_inputs → Bool) → Bool),
      D.num_inputs = 4 → D.size ≤ 6 → ¬(D.computes f) :=
    lrat_implies_lower_bound maj4_lrat_proof_algebraist

  -- Proof by contradiction: assume size <= 6
  by_contra h_not_gt
  have h_le : C.size ≤ 6 := Nat.not_lt.mp h_not_gt

  -- Apply LRAT result to derive contradiction with h_computes
  have h_no_compute : ¬(C.computes (majority C.num_inputs)) :=
    h_lrat C (majority C.num_inputs) h_inputs h_le

  exact h_no_compute h_computes

/-! ## Corollary: Exact Minimum -/

/-- Corollary: Monotone circuit size for MAJ_4 is at least 7.
    Combined with the empirical SAT witness at size 7, the minimum is exactly 7. -/
theorem monotone_maj4_at_least_7 :
  ∀ (C : Circuit),
    C.num_inputs = 4 →
    isMonotone C = true →
    C.computes (majority C.num_inputs) →
    7 ≤ C.size := by
  intro C h_inputs h_monotone h_computes
  have h_gt : C.size > 6 := monotone_maj4_lower_bound C h_inputs h_monotone h_computes
  exact Nat.succ_le_of_lt h_gt

