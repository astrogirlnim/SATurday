/-! ## Theorem A: No monotone circuit of size <= 7 computes MAJ_5 -/

/-- Theorem A: Monotone circuits for MAJ_5 require more than 7 gates.
    Proven via three independent LRAT certificates at g=7 (iter2 seeds: algebraist, geometer, skeptic).

    Algebraist justification: Valiant 1984 gives MC(MAJ_5) >= 5; solver closes to >= 8.
    Geometer justification: K^3_5 covering number 4 forces >= 4 AND gates; total >= 8.
    Three independent seeds corroborate: no single-seed artifact. -/
theorem monotone_maj5_size_gt_7 :
  ∀ (C : Circuit),
    C.num_inputs = 5 →
    isMonotone C = true →
    C.computes (majority C.num_inputs) →
    C.size > 7 := by
  intro C h_inputs h_monotone h_computes
  -- LOG: Proving MAJ_5 lower bound > 7 using primary LRAT certificate g7 algebraist seed44
  -- LOG: g7 algebraist hash 12ce4915e680133fce0f57852eea1cfd1ae0ce22864d2836f9c00b01d8bfd445
  -- LOG: g7 geometer hash   2d240bc07273386ee36df811bc993393ebfe94e20cdceccfa57f21bfb029c12a
  -- LOG: g7 skeptic hash    e17e33ab0b74313d6a9141e36c73385d1872ad8d9fee5a8dbf30db06ae606797

  -- Apply LRAT soundness axiom: certified UNSAT at g=7 implies no circuit of size <= 7 computes any f
  have h_lrat : ∀ (D : Circuit) (f : (Fin D.num_inputs → Bool) → Bool),
      D.num_inputs = 5 → D.size ≤ 7 → ¬(D.computes f) :=
    lrat_implies_lower_bound maj5_lrat_g7_algebraist

  -- Proof by contradiction: assume size <= 7
  by_contra h_not_gt
  have h_le : C.size ≤ 7 := Nat.not_lt.mp h_not_gt

  -- The LRAT certificate rules out any circuit of this size computing any function
  have h_no_compute : ¬(C.computes (majority C.num_inputs)) :=
    h_lrat C (majority C.num_inputs) h_inputs h_le

  exact h_no_compute h_computes

