/-! ## MAJ_5 Function Definition -/

/-- Count the number of true values in a Fin n -> Bool assignment. -/
def countTrue (n : ℕ) (inputs : Fin n → Bool) : ℕ :=
  Finset.univ.sum (fun i => if inputs i then 1 else 0)

/-- MAJ_5: majority vote on n inputs, parameterized.
    Returns true iff strictly more than half of the inputs are true.
    For n=5: returns true iff at least 3 inputs are true. -/
def majority (n : ℕ) (inputs : Fin n → Bool) : Bool :=
  -- threshold: more than half, i.e., >= n/2 + 1
  decide (countTrue n inputs * 2 > n)

