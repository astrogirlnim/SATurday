/-! ## Main Theorem -/

/-- Main theorem: Monotone circuits for MAJ_5 require more than 7 gates.

    This is proven using three independent LRAT-certified UNSAT proofs from SAT solver.
    All three seeds (algebraist, geometer, skeptic) confirm UNSAT at max_gates=7.

    Geometer justification: MAJ_5 has 10 prime implicants of size 3 forming K^3_5.
    Each 2-element pair appears in exactly 3 prime implicants (sunflower core size 2).
    The covering number of K^3_5 by pairs is 4, requiring at least 4 AND gates plus
    at least 4 OR/merge gates = 8 gates minimum. No AND gate sharing is possible.

    Algebraist justification: Razborov approximation with sunflower lemma gives
    MC(MAJ_5) >= floor(0.72 * 5^{3/2}) = 8.

    Tightness note: minimum is in [8, 10]; SAT at max_gates=10 confirmed empirically.
-/
theorem monotone_maj5_lower_bound :
  ∀ (C : Circuit),
    C.num_inputs = 5 →
    isMonotone C = true →
    C.computes (majority C.num_inputs) →
    C.size > 7 := by
  intro C h_inputs h_monotone h_computes
  -- LOG: Proving MAJ_5 lower bound using primary LRAT certificate (iter2, geometer)
  -- LOG: algebraist hash 12ce4915e680133fce0f57852eea1cfd1ae0ce22864d2836f9c00b01d8bfd445
  -- LOG: geometer hash   2d240bc07273386ee36df811bc993393ebfe94e20cdceccfa57f21bfb029c12a
  -- LOG: skeptic hash    e17e33ab0b74313d6a9141e36c73385d1872ad8d9fee5a8dbf30db06ae606797

  -- By LRAT soundness (primary certificate), no circuit with num_inputs=5 and size <= 7
  -- computes any function; in particular it cannot compute majority on 5 inputs
  have h_lrat : ∀ (D : Circuit) (f : (Fin D.num_inputs → Bool) → Bool),
      D.num_inputs = 5 → D.size ≤ 7 → ¬(D.computes f) :=
    lrat_implies_lower_bound maj5_lrat_proof_algebraist

  -- Proof by contradiction: assume size <= 7
  by_contra h_not_gt
  have h_le : C.size ≤ 7 := Nat.not_lt.mp h_not_gt

  -- Apply LRAT result to derive contradiction with h_computes
  have h_no_compute : ¬(C.computes (majority C.num_inputs)) :=
    h_lrat C (majority C.num_inputs) h_inputs h_le

  exact h_no_compute h_computes

/-! ## Corollary: Lower Bound of 8 -/

/-- Corollary: Monotone circuit size for MAJ_5 is at least 8.
    Combined with the empirical SAT witness at size 10, the minimum is in [8, 10]. -/
theorem monotone_maj5_at_least_8 :
  ∀ (C : Circuit),
    C.num_inputs = 5 →
    isMonotone C = true →
    C.computes (majority C.num_inputs) →
    8 ≤ C.size := by
  intro C h_inputs h_monotone h_computes
  have h_gt : C.size > 7 := monotone_maj5_lower_bound C h_inputs h_monotone h_computes
  exact Nat.succ_le_of_lt h_gt

