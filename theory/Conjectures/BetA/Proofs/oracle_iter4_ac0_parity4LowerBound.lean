/-- The parity function on 4 inputs. Returns true iff an odd number of inputs are true. -/
def parity4 (x : Fin 4 -> Bool) : Bool :=
  Bool.xor (Bool.xor (x 0) (x 1)) (Bool.xor (x 2) (x 3))

/-- A binary-fan-in gate type in a depth-bounded AC0 circuit. -/
inductive GateType : Type where
  | AND : GateType  -- fan-in 2: AND(left, right)
  | OR  : GateType  -- fan-in 2: OR(left, right)
  | NOT : GateType  -- fan-in 1: NOT(left)
  deriving DecidableEq, Repr

/-- A gate in a binary-fan-in AC0 circuit. Each gate has a type and two source indices.
    For NOT gates, only src0 is used (src1 is ignored semantically). -/
structure Gate (n_inputs : Nat) (n_gates : Nat) : Type where
  gtype  : GateType
  src0   : Fin (n_inputs + n_gates)  -- left input source
  src1   : Fin (n_inputs + n_gates)  -- right input source (unused for NOT)
  layer  : Nat                       -- depth layer (1-indexed; inputs are at layer 0)
  deriving Repr

