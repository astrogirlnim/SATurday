/-- The majority function on 5 Boolean inputs.
    Returns true iff at least 3 of the 5 inputs are true.
    This is the threshold function THR_{3,5}. -/
def maj5 (x : Fin 5 → Bool) : Bool :=
  let ones := (Finset.univ.filter (fun i => x i = true)).card
  decide (ones >= 3)

/-- A prime implicant of MAJ_5 is a minimal set S of indices such that
    setting all x_i = 1 for i in S forces MAJ_5 = 1 regardless of other inputs.
    For MAJ_5 (threshold 3 of 5), the prime implicants are exactly all 3-element
    subsets of {0,1,2,3,4} = Fin 5.
    There are C(5,3) = 10 such prime implicants. -/
def primeImplicants5 : Finset (Finset (Fin 5)) :=
  Finset.univ.powerset.filter (fun s => s.card = 3)

/-- The number of prime implicants of MAJ_5 equals C(5,3) = 10. -/
lemma primeImplicants5_card : primeImplicants5.card = 10 := by
  native_decide

