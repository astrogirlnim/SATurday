/-- Any monotone gate over GF(2) inputs produces a polynomial of degree
    at most max(deg_left, deg_right) for OR and deg_left + deg_right for AND. -/
def gate_poly_degree_bound (gate : GateType) (d_left d_right : Nat) : Nat :=
  match gate with
  | GateType.AND => d_left + d_right
  | GateType.OR  => max d_left d_right
  | _            => 1  -- input literal has degree 1

